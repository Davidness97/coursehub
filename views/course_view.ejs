<%- include('partials/header') %>

<% if (reqQuery && reqQuery.refreshed) { %>
    <div class="alert" style="background-color: rgba(0, 204, 102, 0.1); color: var(--success); border-color: var(--success);">
        <strong>Contenuti aggiornati!</strong> 
        Aggiunti: <%= reqQuery.added %>, 
        Aggiornati: <%= reqQuery.updated %>, 
        Riattivati: <%= reqQuery.reactivated %>.
    </div>
<% } %>

<div style="display: flex; gap: 2rem; margin-bottom: 2rem; background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden;">
    <img src="<%= getCourseCoverUrl(course) %>" alt="Cover" style="width: 300px; object-fit: cover; background: #333;">
    <div style="padding: 2rem; flex: 1;">
        <h2 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 2rem;">
            <% if (course.category) { %>
                <span class="category-chip" style="font-size: 0.8rem; vertical-align: middle; margin-right: 0.5rem; margin-bottom: 0.2rem;"><%= course.category %></span>
            <% } %>
            <%= course.title %>
        </h2>
        <% if (course.description) { %>
            <p style="color: var(--text-muted); font-size: 1.1rem;"><%= course.description %></p>
        <% } %>
        <div style="margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                <span>Durata Totale: <strong><%= course.total_duration_seconds > 0 ? formatDuration(course.total_duration_seconds) : 'In attesa di scansione' %></strong></span>
                <span>Completato: <strong><%= course.progress_pct || 0 %>%</strong></span>
            </div>
            <div style="height: 8px; background: var(--bg-dark); border-radius: 4px; overflow: hidden; border: 1px solid var(--border);">
                <div style="height: 100%; background: var(--success); width: <%= course.progress_pct || 0 %>%;"></div>
            </div>
        </div>
        
        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <a href="/courses/<%= course.id %>/edit" class="btn btn-outline">Modifica Corso</a>
            <form action="/courses/<%= course.id %>/refresh" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-outline">Aggiorna contenuti</button>
            </form>
            <form action="/courses/<%= course.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Vuoi eliminare il record di questo corso? I file non verranno cancellati.');">
                <button type="submit" class="btn btn-outline" style="border-color: var(--danger); color: var(--danger);">Elimina record</button>
            </form>
        </div>
    </div>
</div>

<style>
/* ... (existing styles might be here, but I will redefine for the new layout) ... */
.layout-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
}
.col-lessons {
    flex: 2;
    min-width: 300px;
}
.col-materials {
    flex: 1;
    min-width: 300px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    height: fit-content;
}

.accordion-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
    overflow: hidden;
}
.accordion-header {
    width: 100%;
    text-align: left;
    background: rgba(255,255,255,0.02);
    padding: 1rem 1.5rem;
    border: none;
    border-bottom: 1px solid var(--border);
    color: var(--text-main);
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.accordion-header:hover {
    background: rgba(255,255,255,0.05);
}
.accordion-content {
    display: none;
}
.accordion-content.active {
    display: block;
}
.accordion-header .icon {
    transition: transform 0.2s ease;
}
.accordion-header[aria-expanded="true"] .icon {
    transform: rotate(90deg);
}

.file-list {
    list-style: none;
    margin: 0;
    padding: 0;
}
.file-item {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.file-item:last-child {
    border-bottom: none;
}
.file-item:hover {
    background: rgba(255,255,255,0.03);
}
.badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 12px;
    background: #444;
    color: #eee;
}
.badge.completed { background: var(--success); color: #000; }
</style>

<div class="layout-grid">
    <div class="col-lessons">
        <h3 style="margin-top: 0;">Lezioni Video</h3>
        
        <% 
        function countLessons(node) {
            let count = node.lessons.length;
            node.children.forEach(c => count += countLessons(c));
            return count;
        }
        %>

        <% if (rootSection.lessons.length > 0 || rootSection.children.length > 0) { 
            const isRootActive = lastWatchedSectionId === rootSection.id;
        %>
            <div class="accordion-item" id="acc-<%= rootSection.id %>">
                <button class="accordion-header" aria-expanded="<%= isRootActive ? 'true' : 'false' %>" onclick="toggleAccordion('<%= rootSection.id %>')">
                    <span><%= rootSection.title %> <small style="color: var(--text-muted); font-weight: normal;">(<%= countLessons(rootSection) %> lezioni)</small></span>
                    <span class="icon">▶</span>
                </button>
                <div class="accordion-content <%= isRootActive ? 'active' : '' %>" id="content-<%= rootSection.id %>">
                    <%- include('partials/course_tree_node', { node: rootSection, course: course, dbLessonsMap: dbLessonsMap, progressMap: progressMap, isRootNode: true }) %>
                </div>
            </div>
        <% } %>

        <% sections.forEach(function(sec) { 
            const isSecActive = lastWatchedSectionId === sec.id;
        %>
            <% if (countLessons(sec) > 0) { %>
                <div class="accordion-item" id="acc-<%= sec.id %>">
                    <button class="accordion-header" aria-expanded="<%= isSecActive ? 'true' : 'false' %>" onclick="toggleAccordion('<%= sec.id %>')">
                        <span><%= sec.title %> <small style="color: var(--text-muted); font-weight: normal;">(<%= countLessons(sec) %> lezioni)</small></span>
                        <span class="icon">▶</span>
                    </button>
                    <div class="accordion-content <%= isSecActive ? 'active' : '' %>" id="content-<%= sec.id %>">
                        <%- include('partials/course_tree_node', { node: sec, course: course, dbLessonsMap: dbLessonsMap, progressMap: progressMap, isRootNode: true }) %>
                    </div>
                </div>
            <% } %>
        <% }); %>
    </div>

    <div class="col-materials">
        <h3 style="margin-top: 0;">Materiale Didattico</h3>
        
        <% 
        function renderMaterial(m) { 
            const encodedPath = m.relativePath.split('/').map(encodeURIComponent).join('/');
            return `
            <div style="margin-bottom: 0.5rem; display: flex; align-items: flex-start; gap: 0.5rem;">
                <span>📄</span>
                <a href="/files/${encodedPath}" target="_blank" style="color: var(--text-muted); text-decoration: none; word-break: break-all; font-size: 0.95rem;">
                    ${m.title}
                </a>
            </div>`;
        }
        
        function extractMaterials(node, materialsArray) {
            node.materials.forEach(m => materialsArray.push(m));
            node.children.forEach(c => extractMaterials(c, materialsArray));
        }
        %>
        
        <% 
        let hasAnyMaterial = false;
        const rootMaterials = [];
        extractMaterials(rootSection, rootMaterials);
        if (rootMaterials.length > 0) {
            hasAnyMaterial = true;
        %>
            <div style="margin-bottom: 1.5rem;">
                <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; color: var(--text-main);">Materiale generale</h4>
                <div style="padding-left: 0.5rem; border-left: 2px solid var(--border);">
                    <%- rootMaterials.map(renderMaterial).join('') %>
                </div>
            </div>
        <% } %>

        <% sections.forEach(function(sec) { 
            const secMaterials = [];
            extractMaterials(sec, secMaterials);
            if (secMaterials.length > 0) {
                hasAnyMaterial = true;
        %>
            <div style="margin-bottom: 1.5rem;">
                <h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; color: var(--text-main);"><%= sec.title %></h4>
                <div style="padding-left: 0.5rem; border-left: 2px solid var(--border);">
                    <%- secMaterials.map(renderMaterial).join('') %>
                </div>
            </div>
        <% } }); %>

        <% if (!hasAnyMaterial) { %>
            <p style="color: var(--text-muted); font-style: italic;">Nessun materiale didattico presente in questo corso.</p>
        <% } %>
    </div>
</div>

<script>
function toggleAccordion(id) {
    const btn = document.querySelector(`#acc-${id} .accordion-header`);
    const content = document.getElementById(`content-${id}`);
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    
    if (isExpanded) {
        btn.setAttribute('aria-expanded', 'false');
        content.classList.remove('active');
    } else {
        btn.setAttribute('aria-expanded', 'true');
        content.classList.add('active');
    }
}
</script>

<!-- Course Note Area -->
<div class="section-card" style="margin-top: 2rem;">
    <div class="section-header">
        <h3>Appunti del Corso</h3>
        <div id="course-note-status" style="font-size: 0.85rem; color: var(--text-muted); float: right;"></div>
    </div>
    <div style="padding: 1.5rem;">
        <textarea id="course-note" rows="8" placeholder="Scrivi qui gli appunti generali del corso..." data-course-id="<%= course.id %>"><%= typeof courseNote !== 'undefined' ? courseNote : '' %></textarea>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const noteArea = document.getElementById('course-note');
    if (!noteArea) return;
    const statusText = document.getElementById('course-note-status');
    const courseId = noteArea.dataset.courseId;
    let typingTimer;
    
    noteArea.addEventListener('keyup', () => {
        clearTimeout(typingTimer);
        statusText.textContent = 'Salvataggio in corso...';
        typingTimer = setTimeout(saveNote, 1000);
    });
    
    noteArea.addEventListener('keydown', () => clearTimeout(typingTimer));

    function saveNote() {
        fetch('/api/notes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'course', id: courseId, content: noteArea.value })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                statusText.textContent = 'Salvata: ' + new Date().toLocaleTimeString();
                statusText.style.color = 'var(--text-muted)';
            } else {
                statusText.textContent = 'Errore nel salvataggio';
                statusText.style.color = 'var(--danger)';
            }
        })
        .catch(err => {
            statusText.textContent = 'Errore di rete';
            statusText.style.color = 'var(--danger)';
        });
    }
});
</script>

<%- include('partials/footer') %>
