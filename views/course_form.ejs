<%- include('partials/header') %>

<h2><%= course.id ? 'Modifica Corso' : 'Aggiungi Corso' %></h2>

<% if (error) { %>
    <div class="alert"><%= error %></div>
<% } %>

<form action="<%= course.id ? '/courses/' + course.id + '/edit' : '/courses/add' %>" method="POST" enctype="multipart/form-data" style="max-width: 600px;">
    
    <div class="form-group">
        <% if (course.id) { %>
            <!-- Single Edit Mode -->
            <label for="title">Titolo Corso</label>
            <input type="text" id="title" name="title" value="<%= course.title %>" required>
            <label for="folder_path" style="margin-top: 1rem;">Cartella Corso (Relativa)</label>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="text" id="folder_path" name="folder_path" value="<%= course.folder_path %>" readonly style="flex: 1; background-color: #222;">
                <button type="button" id="open-folder-picker" class="btn btn-outline">Sfoglia</button>
            </div>
            
            <label for="description" style="margin-top: 1rem;">Descrizione (Opzionale)</label>
            <textarea id="description" name="description" rows="3"><%= course.description %></textarea>
            
            <label for="category" style="margin-top: 1rem;">Categoria (Opzionale)</label>
            <input type="text" id="category" name="category" list="categories-list" value="<%= course.category || '' %>" placeholder="Es. Programmazione, Fotografia...">
        <% } else { %>
            <!-- Multi Add Mode -->
            <label style="margin-bottom: 0.5rem; display: block;">Seleziona Cartelle Corsi</label>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0;">Puoi selezionare una o più cartelle contemporaneamente per creare più corsi.</p>
            <button type="button" id="open-folder-picker" class="btn btn-outline" style="margin-bottom: 1rem;">Sfoglia Cartelle</button>
            
            <div id="multi-select-preview" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem;">
                <!-- Filled by JS -->
            </div>
            
            <label for="description" style="margin-top: 1rem;">Descrizione Comune (Opzionale)</label>
            <textarea id="description" name="description" rows="3" placeholder="Questa descrizione verrà applicata a tutti i corsi creati..."><%= course.description %></textarea>
            
            <label for="category" style="margin-top: 1rem;">Categoria Comune (Opzionale)</label>
            <input type="text" id="category" name="category" list="categories-list" value="<%= course.category || '' %>" placeholder="Verrà applicata a tutti i corsi creati...">
        <% } %>
        
        <datalist id="categories-list">
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                    <option value="<%= cat %>">
                <% }) %>
            <% } %>
        </datalist>
        
        <div style="margin-top: 1rem; padding: 1rem; background: rgba(0, 150, 255, 0.1); border: 1px solid rgba(0, 150, 255, 0.3); border-radius: var(--radius);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h4 style="margin: 0 0 0.5rem 0; color: #fff;">Ricerca Automatica (Google Custom Search)</h4>
                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-muted);">Cerca una descrizione e copertine suggerite dal web.</p>
                </div>
                <button type="button" id="btn-ddg-search" class="btn btn-outline" style="border-color: #0096ff; color: #0096ff;">🔍 Cerca sul Web</button>
            </div>
            <div id="ddg-search-status" style="font-size: 0.85rem; margin-top: 0.5rem;"></div>
            
            <div id="ddg-image-proposals" style="display: none; margin-top: 1rem;">
                <h5 style="margin: 0 0 0.5rem 0;">Seleziona una Copertina:</h5>
                <div id="ddg-image-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 0.5rem;">
                    <!-- Images injected here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Copertina da Browser (Upload) -->
    <div class="form-group" style="padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
        <label>Copertina del Corso</label>
        
        <div style="margin-bottom: 1rem;">
            <strong>Opzione 1:</strong> Carica dal computer
            <input type="file" id="cover" name="cover" accept="image/*" style="margin-top: 0.5rem;">
        </div>
        
        <div style="margin-bottom: 1rem;">
            <strong>Opzione 2:</strong> Seleziona un'immagine già presente nei corsi
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <input type="text" id="cover_fs_path" name="cover_fs_path" value="<%= course.cover_type === 'filesystem' ? course.cover_path : '' %>" readonly placeholder="Nessuna immagine selezionata" style="flex: 1; background-color: #222;">
                <button type="button" id="open-cover-picker" class="btn btn-outline">Sfoglia Immagini</button>
            </div>
        </div>
        
        <div style="margin-bottom: 1rem;">
            <strong>Opzione 3:</strong> Usa immagine da URL internet
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <input type="text" id="cover_url_input" placeholder="https://esempio.com/immagine.jpg" style="flex: 1;">
                <button type="button" id="btn-download-cover" class="btn btn-outline">Scarica e usa</button>
            </div>
            <div id="cover-url-status" style="font-size: 0.85rem; margin-top: 0.25rem;"></div>
            <!-- Hidden field to hold the downloaded filename so we can submit it as uploaded type -->
            <input type="hidden" id="cover_downloaded_filename" name="cover_downloaded_filename" value="">
        </div>

        <% if (course.id && course.cover_path) { %>
            <div style="margin-top: 1rem;">
                <label>Copertina attuale:</label>
                <img src="<%= getCourseCoverUrl(course) %>" id="current-cover-preview" style="max-width: 200px; border-radius: var(--radius); border: 1px solid var(--border);">
            </div>
        <% } %>
    </div>
    
    <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border);">
        <button type="submit" class="btn">Salva Corso</button>
        <a href="/" class="btn btn-outline" style="margin-left: 1rem;">Annulla</a>
    </div>
</form>

<!-- Folder Picker Modal -->
<div id="folder-picker-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Seleziona Cartella Corso</h2>
            <button type="button" class="close-modal" id="close-folder-picker">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display: flex; gap: 1rem; margin-bottom: 1rem; align-items: center;">
                <button type="button" id="go-parent-folder" class="btn btn-outline">Su</button>
                <div id="current-folder-path" style="flex: 1; font-family: monospace; padding: 0.5rem; background: var(--bg-dark); border-radius: 4px;">/courses/</div>
            </div>
            <div id="folder-picker-list" style="display: flex; flex-direction: column; gap: 0.5rem;">
                <!-- Folders injected via JS -->
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" id="close-folder-picker-footer">Annulla</button>
            <button type="button" class="btn" id="use-current-folder">Seleziona questa cartella</button>
        </div>
    </div>
</div>

<!-- Cover Picker Modal -->
<div id="cover-picker-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Seleziona Immagine Copertina</h2>
            <button type="button" class="close-modal" id="close-cover-picker">&times;</button>
        </div>
        <div class="modal-body">
            <div style="display: flex; gap: 1rem; margin-bottom: 1rem; align-items: center;">
                <button type="button" id="go-parent-cover" class="btn btn-outline">Su</button>
                <div id="current-cover-path" style="flex: 1; font-family: monospace; padding: 0.5rem; background: var(--bg-dark); border-radius: 4px;">/courses/</div>
            </div>
            <div id="cover-picker-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 1rem;">
                <!-- Files/Folders injected via JS -->
            </div>
        </div>
        <div class="modal-footer">
            <span id="cover-selected-status" style="margin-right: auto; align-self: center; color: var(--primary);"></span>
            <button type="button" class="btn btn-outline" id="close-cover-picker-footer">Annulla</button>
            <button type="button" class="btn" id="use-selected-cover" disabled>Conferma selezione</button>
        </div>
    </div>
</div>

<script>
// Isolate Folder Picker Logic
(function() {
    const isEditMode = <%= !!course.id %>;
    const modal = document.getElementById('folder-picker-modal');
    const openBtn = document.getElementById('open-folder-picker');
    if (!openBtn) return;
    
    const closeBtns = [document.getElementById('close-folder-picker'), document.getElementById('close-folder-picker-footer')];
    const listEl = document.getElementById('folder-picker-list');
    const pathEl = document.getElementById('current-folder-path');
    const parentBtn = document.getElementById('go-parent-folder');
    const useBtn = document.getElementById('use-current-folder');
    const inputPath = document.getElementById('folder_path');
    
    let currentPath = '';
    let parentPath = '';
    
    // For Add Mode: Track multiple selected paths
    const selectedPaths = new Set();
    
    function renderMultiSelectUI() {
        if (isEditMode) return;
        const container = document.getElementById('multi-select-preview');
        if (!container) return;
        
        if (selectedPaths.size === 0) {
            container.innerHTML = '<p style="color: var(--text-muted); font-style: italic;">Nessuna cartella selezionata.</p>';
            return;
        }
        
        let html = '<div style="display: flex; flex-direction: column; gap: 0.5rem;">';
        selectedPaths.forEach(path => {
            const defaultTitle = path.split('/').pop().replace(/[-_]/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            html += `
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="hidden" name="multi_folder_paths[]" value="${path}">
                <input type="text" name="multi_titles[]" value="${defaultTitle}" style="flex: 1; padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-dark);" required>
                <code style="background: var(--bg-dark); padding: 0.5rem; font-size: 0.8rem; border-radius: 4px;">${path}</code>
                <button type="button" class="btn btn-outline btn-remove-path" data-path="${path}" style="border-color: var(--danger); color: var(--danger); padding: 0.5rem;">&times;</button>
            </div>
            `;
        });
        html += '</div>';
        container.innerHTML = html;
        
        container.querySelectorAll('.btn-remove-path').forEach(btn => {
            btn.addEventListener('click', (e) => {
                selectedPaths.delete(e.target.dataset.path);
                renderMultiSelectUI();
            });
        });
    }

    function loadFolderBrowser(path) {
        if (isEditMode) useBtn.disabled = true;
        
        fetch('/api/browse-folders?path=' + encodeURIComponent(path))
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert('Errore: ' + data.error);
                    return;
                }
                
                currentPath = data.current;
                parentPath = data.parent;
                
                pathEl.textContent = '/courses/' + (currentPath ? currentPath : '');
                parentBtn.disabled = !currentPath;
                if (isEditMode) useBtn.disabled = !currentPath;
                
                listEl.innerHTML = '';
                if (data.folders.length === 0) {
                    listEl.innerHTML = '<div style="color: var(--text-muted); text-align: center; padding: 1rem;">Nessuna sottocartella</div>';
                }
                
                data.folders.forEach(f => {
                    const item = document.createElement('div');
                    item.style.padding = '1rem';
                    item.style.backgroundColor = 'var(--bg-dark)';
                    item.style.border = '1px solid var(--border)';
                    item.style.borderRadius = 'var(--radius)';
                    item.style.cursor = 'pointer';
                    item.style.display = 'flex';
                    item.style.alignItems = 'center';
                    
                    let contentHtml = `<div style="display: flex; align-items: center; gap: 0.5rem; flex: 1;">
                        <span style="font-size: 1.5rem;">📁</span>
                        <span>${f.name}</span>
                    </div>`;
                    
                    if (!isEditMode) {
                        const isChecked = selectedPaths.has(f.path) ? 'checked' : '';
                        contentHtml = `<input type="checkbox" class="folder-checkbox" data-path="${f.path}" ${isChecked} style="margin-right: 1rem; width: 20px; height: 20px; cursor: pointer;">` + contentHtml;
                    }
                    
                    item.innerHTML = contentHtml;
                    
                    item.addEventListener('mouseenter', () => item.style.backgroundColor = 'var(--bg-hover)');
                    item.addEventListener('mouseleave', () => item.style.backgroundColor = 'var(--bg-dark)');
                    
                    if (isEditMode) {
                        item.addEventListener('click', () => loadFolderBrowser(f.path));
                    } else {
                        // In Add Mode, clicking the text goes inside. Clicking the checkbox selects it.
                        const cb = item.querySelector('.folder-checkbox');
                        cb.addEventListener('change', (e) => {
                            if (e.target.checked) selectedPaths.add(f.path);
                            else selectedPaths.delete(f.path);
                        });
                        item.querySelector('div').addEventListener('click', () => loadFolderBrowser(f.path));
                    }
                    
                    listEl.appendChild(item);
                });
            })
            .catch(err => {
                console.error(err);
                alert('Errore di comunicazione');
            });
    }
    
    openBtn.addEventListener('click', () => {
        modal.classList.add('active');
        let initial = currentPath;
        if (isEditMode && inputPath && inputPath.value) {
            initial = inputPath.value;
        }
        loadFolderBrowser(initial);
    });
    
    closeBtns.forEach(btn => btn.addEventListener('click', () => {
        modal.classList.remove('active');
        if (!isEditMode) renderMultiSelectUI();
    }));
    
    parentBtn.addEventListener('click', () => {
        loadFolderBrowser(parentPath);
    });
    
    useBtn.addEventListener('click', () => {
        if (isEditMode) {
            if (inputPath) inputPath.value = currentPath;
        } else {
            renderMultiSelectUI();
        }
        modal.classList.remove('active');
    });
    
    // Init Multi Select UI if Add Mode
    if (!isEditMode) renderMultiSelectUI();
})();

// Isolate Cover Picker Logic
(function() {
    const modal = document.getElementById('cover-picker-modal');
    const openBtn = document.getElementById('open-cover-picker');
    const closeBtns = [document.getElementById('close-cover-picker'), document.getElementById('close-cover-picker-footer')];
    const listEl = document.getElementById('cover-picker-list');
    const pathEl = document.getElementById('current-cover-path');
    const parentBtn = document.getElementById('go-parent-cover');
    const useBtn = document.getElementById('use-selected-cover');
    const statusEl = document.getElementById('cover-selected-status');
    const inputPath = document.getElementById('cover_fs_path');
    const folderInputPath = document.getElementById('folder_path'); // Used ONLY to hint initial directory
    
    let currentPath = '';
    let parentPath = '';
    let selectedFile = null;
    
    function loadFileBrowser(path) {
        selectedFile = null;
        useBtn.disabled = true;
        statusEl.textContent = '';
        
        fetch('/api/browse-images?path=' + encodeURIComponent(path))
            .then(res => res.json())
            .then(data => {
                if (data.error) {
                    alert('Errore: ' + data.error);
                    return;
                }
                
                currentPath = data.current;
                parentPath = data.parent;
                
                pathEl.textContent = '/courses/' + (currentPath ? currentPath : '');
                parentBtn.disabled = !currentPath;
                
                listEl.innerHTML = '';
                if (data.folders.length === 0 && data.images.length === 0) {
                    listEl.innerHTML = '<div style="grid-column: 1/-1; color: var(--text-muted); text-align: center; padding: 1rem;">Nessuna cartella o immagine</div>';
                }
                
                data.folders.forEach(f => {
                    const item = document.createElement('div');
                    item.style.padding = '1rem';
                    item.style.backgroundColor = 'var(--bg-dark)';
                    item.style.border = '1px solid var(--border)';
                    item.style.borderRadius = 'var(--radius)';
                    item.style.cursor = 'pointer';
                    item.style.textAlign = 'center';
                    item.innerHTML = '<div style="font-size: 2rem;">📁</div><div style="font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="'+f.name+'">' + f.name + '</div>';
                    
                    item.addEventListener('mouseenter', () => item.style.backgroundColor = 'var(--bg-hover)');
                    item.addEventListener('mouseleave', () => item.style.backgroundColor = 'var(--bg-dark)');
                    
                    item.addEventListener('click', () => {
                        loadFileBrowser(f.path);
                    });
                    
                    listEl.appendChild(item);
                });
                
                data.images.forEach(img => {
                    const item = document.createElement('div');
                    item.style.padding = '0.5rem';
                    item.style.backgroundColor = 'var(--bg-dark)';
                    item.style.border = '2px solid var(--border)';
                    item.style.borderRadius = 'var(--radius)';
                    item.style.cursor = 'pointer';
                    item.style.textAlign = 'center';
                    item.style.display = 'flex';
                    item.style.flexDirection = 'column';
                    item.style.alignItems = 'center';
                    
                    // We can use the /files route to preview images!
                    const encodedParts = img.path.split('/').map(encodeURIComponent).join('/');
                    const imgUrl = '/files/' + encodedParts;
                    
                    item.innerHTML = '<img src="' + imgUrl + '" style="width: 100%; height: 80px; object-fit: cover; border-radius: 4px; margin-bottom: 0.5rem;"><div style="font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%;" title="'+img.name+'">' + img.name + '</div>';
                    
                    item.addEventListener('click', () => {
                        // Deselect all others
                        Array.from(listEl.children).forEach(c => c.style.borderColor = 'var(--border)');
                        item.style.borderColor = 'var(--primary)';
                        selectedFile = img.path;
                        useBtn.disabled = false;
                        statusEl.textContent = 'Selezionato: ' + img.name;
                    });
                    
                    listEl.appendChild(item);
                });
            })
            .catch(err => {
                console.error(err);
                alert('Errore di comunicazione');
            });
    }
    
    openBtn.addEventListener('click', () => {
        modal.classList.add('active');
        // Initial path: if we have a fs path already, use its dir. 
        // Else if course folder is set, try to use it as starting point. 
        // Else root.
        let initial = '';
        if (inputPath.value) {
            initial = inputPath.value.substring(0, inputPath.value.lastIndexOf('/'));
        } else if (folderInputPath && folderInputPath.value) {
            initial = folderInputPath.value;
        }
        loadFileBrowser(initial);
    });
    
    closeBtns.forEach(btn => btn.addEventListener('click', () => {
        modal.classList.remove('active');
    }));
    
    parentBtn.addEventListener('click', () => {
        loadFileBrowser(parentPath);
    });
    
    useBtn.addEventListener('click', () => {
        if (selectedFile) {
            inputPath.value = selectedFile;
            document.getElementById('cover').value = ""; // Clear file input
        }
        modal.classList.remove('active');
    });
})();

// Cover URL Logic
(function() {
    const btn = document.getElementById('btn-download-cover');
    const input = document.getElementById('cover_url_input');
    const status = document.getElementById('cover-url-status');
    const hiddenInput = document.getElementById('cover_downloaded_filename');
    
    if (!btn) return;
    
    btn.addEventListener('click', () => {
        const url = input.value.trim();
        if (!url) return;
        
        btn.disabled = true;
        status.textContent = 'Scaricamento in corso...';
        status.style.color = 'var(--text-muted)';
        
        fetch('/api/download-cover', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            if (data.error) {
                status.textContent = 'Errore: ' + data.error;
                status.style.color = 'var(--danger)';
            } else if (data.success && data.filename) {
                status.textContent = 'Immagine scaricata e impostata!';
                status.style.color = 'var(--success)';
                hiddenInput.value = data.filename;
                // Clear other inputs to avoid confusion
                document.getElementById('cover_fs_path').value = '';
                document.getElementById('cover').value = '';
                
                const preview = document.getElementById('current-cover-preview');
                if (preview) {
                    preview.src = '/uploads/covers/' + encodeURIComponent(data.filename);
                }
            }
        })
        .catch(err => {
            btn.disabled = false;
            status.textContent = 'Errore di rete';
            status.style.color = 'var(--danger)';
        });
    });
})();

// DuckDuckGo Search Logic
(function() {
    const btn = document.getElementById('btn-ddg-search');
    const status = document.getElementById('ddg-search-status');
    const proposalsContainer = document.getElementById('ddg-image-proposals');
    const grid = document.getElementById('ddg-image-grid');
    
    if (!btn) return;
    
    btn.addEventListener('click', () => {
        let query = '';
        const isEditMode = <%= !!course.id %>;
        
        if (isEditMode) {
            query = document.getElementById('title').value;
        } else {
            // Pick the first folder path or title in multi mode
            const firstTitleInput = document.querySelector('input[name="multi_titles[]"]');
            const firstPathInput = document.querySelector('input[name="multi_folder_paths[]"]');
            
            if (firstTitleInput && firstTitleInput.value) query = firstTitleInput.value;
            else if (firstPathInput && firstPathInput.value) query = firstPathInput.value;
        }
        
        if (!query) {
            status.textContent = 'Errore: Inserisci un titolo o seleziona una cartella per cercare.';
            status.style.color = 'var(--danger)';
            return;
        }
        
        btn.disabled = true;
        status.textContent = 'Ricerca in corso su Google...';
        status.style.color = 'var(--text-muted)';
        proposalsContainer.style.display = 'none';
        
        fetch('/api/search-metadata', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            if (data.error) {
                status.textContent = 'Errore: ' + data.error;
                status.style.color = 'var(--danger)';
                return;
            }
            
            status.textContent = `Trovato per "${data.query}".`;
            status.style.color = 'var(--success)';
            
            if (data.description) {
                document.getElementById('description').value = data.description;
            }
            
            if (data.images && data.images.length > 0) {
                proposalsContainer.style.display = 'block';
                grid.innerHTML = '';
                
                data.images.forEach(imgUrl => {
                    const wrap = document.createElement('div');
                    wrap.style.cursor = 'pointer';
                    wrap.style.border = '2px solid transparent';
                    wrap.style.borderRadius = 'var(--radius)';
                    wrap.style.overflow = 'hidden';
                    wrap.style.height = '75px';
                    
                    const img = document.createElement('img');
                    img.src = imgUrl;
                    img.style.width = '100%';
                    img.style.height = '100%';
                    img.style.objectFit = 'cover';
                    
                    wrap.appendChild(img);
                    
                    wrap.addEventListener('mouseenter', () => wrap.style.borderColor = 'rgba(255,255,255,0.5)');
                    wrap.addEventListener('mouseleave', () => wrap.style.borderColor = 'transparent');
                    
                    wrap.addEventListener('click', () => {
                        // Evidenzia selezione
                        Array.from(grid.children).forEach(c => c.style.borderColor = 'transparent');
                        wrap.style.borderColor = 'var(--primary)';
                        
                        // Compila campo URL e avvia il download SSRF
                        const urlInput = document.getElementById('cover_url_input');
                        if (urlInput) {
                            urlInput.value = imgUrl;
                            const dlBtn = document.getElementById('btn-download-cover');
                            if (dlBtn) {
                                dlBtn.click();
                            }
                        }
                    });
                    
                    grid.appendChild(wrap);
                });
            } else {
                status.textContent += ' Nessuna immagine trovata.';
            }
        })
        .catch(err => {
            btn.disabled = false;
            status.textContent = 'Errore di rete';
            status.style.color = 'var(--danger)';
        });
    });
})();
</script>

<%- include('partials/footer') %>
